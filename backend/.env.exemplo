# Copie para .env no desenvolvimento. No Railway, defina como variáveis do serviço.

# Railway injeta automaticamente ao adicionar o plugin MySQL.
DATABASE_URL=mysql://usuario:senha@host:3306/railway

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HORAS=12

AMBIENTE=producao
# Caminhos relativos partem de backend/.
MALHA_ARQUIVO=dados/malha.json

# Domínio do front no Vercel. Vários separados por vírgula.
CORS_ORIGENS=https://truecompass.vercel.app,http://localhost:5173

# ---- conta e login
# E-mail com o código de 6 dígitos (confirmar conta, recuperar senha).
# Brevo (recomendado, grátis até 300/dia, sem domínio próprio): crie a chave em
# brevo.com (SMTP & API -> API Keys) e confirme o EMAIL_REMETENTE em Senders.
BREVO_API_KEY=
# Resend (grátis até 100/dia): crie a chave em resend.com.
# Sem domínio verificado, a Resend só entrega no e-mail do dono da conta.
RESEND_API_KEY=
EMAIL_REMETENTE=TrueCompass <onboarding@resend.dev>
# Ou SMTP (ex.: Gmail com "senha de app"): SMTP_HOST=smtp.gmail.com, porta 587.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
# Liga sozinho quando há Resend ou SMTP. Sem e-mail, fica desligado (o código
# não chegaria a ninguém) e o cadastro abre a conta na hora.
# CONFIRMAR_EMAIL=1
# "Continuar com Google": ID do cliente OAuth (o MESMO do VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# "Manter conectado": validade do token de renovação, em dias.
RENOVACAO_DIAS=30

MATCHING_RAIO_M=3000
MATCHING_MAX_CANDIDATOS=20
MATCHING_LIMITE_S=900
