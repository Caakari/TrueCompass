# Copie para .env no desenvolvimento. No Railway, defina como variáveis do serviço.

# Railway injeta automaticamente ao adicionar o plugin MySQL.
DATABASE_URL=mysql://usuario:senha@host:3306/railway

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HORAS=12

AMBIENTE=producao
MALHA_ARQUIVO=dados/malha.json

# Domínio do front no Vercel. Vários separados por vírgula.
CORS_ORIGENS=https://truecompass.vercel.app,http://localhost:5173

MATCHING_RAIO_M=3000
MATCHING_MAX_CANDIDATOS=20
MATCHING_LIMITE_S=900
